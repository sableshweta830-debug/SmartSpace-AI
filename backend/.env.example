# Backend Environment Variables
APP_NAME="Intent-to-Interface: Adaptive AI Workspace"
PORT=8000
HOST=127.0.0.1
DEBUG=True

# SQLite Database (Default)
DATABASE_URL=sqlite:///./workspace.db

# PostgreSQL / Supabase Database (Optional)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Optional External AI API (Optional - application runs completely offline using rule-based engine if not provided)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# AI_PROVIDER=fallback # or openai / gemini
